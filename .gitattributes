# .gitattributes
# SPDX-License-Identifier: GPL-2.0-only

# Force consistent LF line endings for all source code
* text=auto eol=lf

# Force specific text encoding for low-level source files
*.cpp text diff=cpp
*.hpp text diff=cpp
*.h   text diff=cpp
*.S   text diff=asm
*.s   text diff=asm
*.asm text diff=asm

# Configuration and Build automation scripts
Makefile text
*.ld     text
*.yml    text
*.yaml   text
*.json   text

# Documentation standards
README       text
CONTRIBUTING text
GOVERNANCE   text
LICENSE      text
MAINTAINERS  text
*.rst        text

# Binary file handling to prevent Git corruption
*.elf binary
*.bin binary
*.img binary
*.o   binary
