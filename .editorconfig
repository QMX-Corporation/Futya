# .editorconfig
# SPDX-License-Identifier: GPL-2.0-only

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{asm,S,s}]
indent_style = tab
indent_size = 8

[*.js]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
